# Copy to .env and fill in. Never commit .env.
GUAVA_API_KEY=gva-...
GUAVA_AGENT_NUMBER=+12403691080
GOOGLE_MAPS_API_KEY=
# Same value as GOOGLE_MAPS_API_KEY; Vite exposes it to the dashboard's Google Maps JS loader.
VITE_GOOGLE_MAPS_API_KEY=
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=

# Demo phones (E.164, consenting teammates). Caller ID decides each caller's role.
PHARMACY_PHONE=+1
STAFF_PHONE=+1
FACILITY_A_PHONE=+1
FACILITY_B_PHONE=+1
FACILITY_C_PHONE=+1
FACILITY_D_PHONE=+1
FACILITY_E_PHONE=+1
FACILITY_F_PHONE=+1
FACILITY_G_PHONE=+1
FACILITY_H_PHONE=+1

# SMS alerts (Guava). off (default) = log alerts as "simulated" on the dashboard, never text anyone.
COLDLINE_SMS=off
# Link sent to staff when a recommendation is ready.
COLDLINE_DASHBOARD_URL=http://localhost:5173
# GraphQL API port (the Vite dev server proxies /graphql here).
COLDLINE_API_PORT=4000
